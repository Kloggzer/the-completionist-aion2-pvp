<Project Sdk="Microsoft.NET.Sdk">

  <!-- Checks of the PvP overlay: window placement (Placement.cs) and the decoders (PlayerFrames.cs) on a capture dump:
       python tools/analyze_capture.py captures/20261019-201703 (dump option) frames.jsonl
       dotnet run (project tools/pvpcheck) with frames.jsonl as argument
       Exit code 0 = all expectations met. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PetOverlay</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\PlayerFrames.cs" Link="PlayerFrames.cs" />
    <Compile Include="..\..\Protocol.cs" Link="Protocol.cs" />
    <Compile Include="..\..\Placement.cs" Link="Placement.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
  </ItemGroup>

</Project>
